@page "/aracekle"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Araç Ekle</PageTitle>

<h1>Araç Ekle</h1>

<div class="message">
    @mesaj
</div>

<form method="post" @onsubmit="YeniAracEkle" >
    <div>
        Plaka: <input type="text" maxlength="10" @bind="Plaka" required/>
    </div>
    <div>
        Sınıf: <select @bind="SertifikaSinifi" required>
            <option value="A" selected>A</option>
            <option value="A1">A1</option>
            <option value="A2">A2</option>
            <option value="B">B</option>
            <option value="B1">B1</option>
            <option value="C">C</option>
            <option value="C1">C1</option>
            <option value="D">D</option>
            <option value="E">E</option>
        </select>
    </div>
    <div>
        Vites: <select @bind="VitesCesidi" required>
            <option value="Manuel" selected>Manuel</option>
            <option value="Otomatik">Otomatik</option>
        </select>
    </div>
    <div>
        Marka: <input type="text" maxlength="20" @bind="Marka"/>
    </div>
    <div>
        Model: <input type="text" maxlength="50" @bind="AracModeli"/>
    </div>
    <div>
        Yıl: <input type="text" maxlength="4" @bind="Yil"/>
    </div>
    <div>
        Kilometre: <input type="text" maxlength="10" @bind="AracKilometresi"/>
    </div>
    <button type="submit" class="btn">Yeni araç ekle</button>
</form>

@code {
    private string Plaka = "";
    private string SertifikaSinifi = "";
    private string VitesCesidi = "";
    private string Marka = "";
    private string AracModeli = "";
    private string Yil = "2000";
    private string AracKilometresi = "0";
    private string mesaj = "";
    private async Task YeniAracEkle()
    {
        using SurucuKursuContext db = DbFactory.CreateDbContext();
        var yeniArac = new Models.Araclar
        {
            Plaka = Plaka.ToUpper(),
            SertifikaSinifi = SertifikaSinifi,
            VitesCesidi = VitesCesidi,
            Marka = Marka,
            AracModeli = AracModeli,
            Yil = Convert.ToInt16(Yil),
            AracKilometresi = Convert.ToInt32(AracKilometresi),
        };
        try
        {
            mesaj = "Araç ekleniyor...";
            db.Araclar.Add(yeniArac);
            await db.SaveChangesAsync();
            mesaj = "Yeni araç başarıyla eklendi";
        }
        catch (Exception ex)
        {
            mesaj = ex.InnerException?.Message ?? "Bir hata meydana geldi";
        }
    }
}