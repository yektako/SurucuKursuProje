@page "/goster"
@rendermode InteractiveServer
@inject NavigationManager Navigation

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        string index = "";
        string uri = Navigation.Uri;
        if (uri.Contains("#") && uri.IndexOf("#") < uri.Length-1)
        {
            index = Navigation.Uri.Split("#").Last();
        }
        string uriYonlendir = Navigation.BaseUri+"#"+index;
        Navigation.NavigateTo(uriYonlendir);
    }
}